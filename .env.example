# Copy to .env and adjust for your environment. All values below are optional;
# sensible defaults are applied in src/config.py if unset.

# --- Flask API (dashboard/backend) ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:3000

# --- Bayesian change-point model (src/modeling/change_point_model.py) ---
BRENT_MCMC_DRAWS=2000
BRENT_MCMC_TUNE=1500
BRENT_MCMC_CHAINS=4
BRENT_MCMC_TARGET_ACCEPT=0.95
BRENT_RANDOM_SEED=42

# --- Optional AI narrative generation (src/ai/narrative.py) ---
# If unset, the pipeline falls back to a deterministic template - no
# functionality is lost, the narrative just won't be LLM-generated.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# --- Path overrides (rarely needed; defaults resolve relative to repo root) ---
# BRENT_DATA_RAW=./data/raw
# BRENT_DATA_PROCESSED=./data/processed
# BRENT_OUTPUTS=./outputs
