# Multi-stage build: compile the React app, then serve the static bundle
# with nginx. CRA bakes REACT_APP_* vars in at build time, so it's passed
# as a build ARG (see docker-compose.yml) rather than a runtime env var.
FROM node:20-alpine AS build
WORKDIR /app
COPY dashboard/frontend/package.json dashboard/frontend/package-lock.json ./
RUN npm ci
COPY dashboard/frontend/ .
ARG REACT_APP_API_URL=http://localhost:5000
ENV REACT_APP_API_URL=$REACT_APP_API_URL
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY dashboard/frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
